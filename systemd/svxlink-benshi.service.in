[Unit]
Description=Benshi radio to SvxLink NetTrx bridge
Documentation=file://@CMAKE_INSTALL_FULL_DOCDIR@/README.md
After=bluetooth.service network.target
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/svxlink-benshi --config @CMAKE_INSTALL_FULL_SYSCONFDIR@/svxlink-benshi.conf
Restart=on-failure
RestartSec=5
User=svxlink
Group=svxlink
# The radio is controlled over Bluetooth RFCOMM; no extra capabilities are
# normally required. If your distribution restricts Bluetooth sockets, add
# SupplementaryGroups=bluetooth here.

[Install]
WantedBy=multi-user.target
