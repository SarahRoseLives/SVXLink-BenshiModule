[Unit]
Description=SvxLink voice services node
Documentation=man:svxlink(1)
After=network.target svxlink-benshi.service
Wants=svxlink-benshi.service

[Service]
Type=simple
User=svxlink
Group=svxlink
ExecStart=/usr/bin/svxlink --config=/etc/svxlink/svxlink.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
